# Instagram API with Instagram Login (graph.instagram.com)
IG_ACCESS_TOKEN=your-long-lived-instagram-user-access-token
# Your Instagram professional account ID (run `npm run list-reels` to see it)
IG_USER_ID=
# Instagram app secret: Meta app dashboard → Instagram → API setup with Instagram login →
# Business login settings. Used to verify webhook signatures. If webhooks get rejected with
# "bad signature", use App settings → Basic → App secret instead.
APP_SECRET=
# Any string you choose; enter the same value in the Meta webhook settings
VERIFY_TOKEN=pick-a-random-string
PORT=3000
GRAPH_VERSION=v23.0
# Set to 1 to log DMs/replies instead of calling Instagram
DRY_RUN=0
